# Backend environment variables (copy to backend/.env)
APP_ENV=development
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=sqlite:///./youth_benefits.db

# Fill these only after checking the official API documentation
PUBLIC_DATA_API_KEY=
PUBLIC_DATA_API_BASE_URL=

# ===== 기존 .env.example 맨 아래에 붙여넣을 내용 (이 파일은 붙여넣은 뒤 지우세요) =====
# 공공데이터포털: 지자체복지서비스 (backend)
# 마이페이지 > 개인 API 인증키 > 일반 인증키 (Encoding/Decoding 중 아무거나 가능)
# backend/.env 에 작성 (커밋 금지)
DATA_GO_KR_SERVICE_KEY=여기에_발급받은_키
# 아래는 선택(기본값 있음)
# DEFAULT_LIFE_CODE=003,004      # 기본 생애주기(쉼표로 여러 개, 합집합)
# WELFARE_SOURCE=auto            # auto: 가능하면 스냅샷 | live: 항상 공공 API | snapshot: 스냅샷만(데모용)
# WELFARE_API_TIMEOUT=15         # 초(호출 1회당). 공공 API 가 간헐적으로 멈춤
# WELFARE_API_RETRIES=1
# CORS_ORIGINS=http://localhost:5173
